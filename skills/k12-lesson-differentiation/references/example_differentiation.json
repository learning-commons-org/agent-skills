{
  "shared": {
    "subject": "Mathematics",
    "grade": "Grade 4",
    "standard_code": "4.NF.B.3.d",
    "standard_text": "Solve word problems involving addition and subtraction of fractions referring to the same whole and having like denominators, e.g., by using visual fraction models and equations to represent the problem.",
    "vocabulary": [
      {
        "term": "denominator",
        "definition": "The bottom number of a fraction — how many equal parts the whole is split into."
      },
      {
        "term": "like denominators",
        "definition": "Fractions whose wholes are split into the same number of parts."
      }
    ],
    "sentence_frames": [
      "I know ____ and ____. The part I don't know is ____.",
      "My strategy was ____ because ____."
    ],
    "misconceptions": [
      {
        "what": "Adds denominators as well as numerators (3/8 + 2/8 = 5/16)",
        "why": "Treats numerator and denominator as separate whole numbers",
        "move": "Return to the tape diagram: how many eighths in all?"
      }
    ],
    "problems": [
      {
        "text": "Maria's family ate 3/8 of a veggie pizza and 2/8 of the same pizza later. How much of the pizza did they eat in all?",
        "difficulty": "core"
      },
      {
        "text": "After eating, 1/8 of the pizza fell on the floor. How much pizza is left to share?",
        "difficulty": "stretch"
      }
    ],
    "exit_ticket": {
      "prompt": "Jon says 4/6 + 1/6 = 5/12. Is he right? Use a picture or equation to prove your answer.",
      "buckets": [
        "Got it",
        "Almost there",
        "Needs re-teaching"
      ]
    },
    "anchor_activity": "Finished early? Choose one problem from this page and prove your answer a second way, using a tape diagram. Then write one new question about the pizza whose answer is more than one whole, and solve it.",
    "reflect_prompt": "What strategy did you use and why?"
  },
  "theme": {
    "primary": "#17A267"
  },
